<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageTags>Krosoft Extension Mail Smtp Mailjet</PackageTags>
		<Description>Package pour faciliter l'envoi de mails via Mailjet.</Description>
	</PropertyGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Mailjet.Api" Version="4.1.0" />
		<PackageReference Include="Krosoft.Extensions.Core" Version="2026.11.16.13416" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Krosoft.Extensions.Mail.Abstractions\Krosoft.Extensions.Mail.Abstractions.csproj" />
	</ItemGroup>
</Project>